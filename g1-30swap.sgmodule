#!name=g1-30swap
#!desc=Google One Web 流: 把 one.google.com 下发的 AI Ultra 30TB SKU (g1.ios.30tb.ai.pro.m) 替换为纯存储 30TB SKU (g1.ios.30tb.m)。服务端按客户端提交的 SKU 结算。
#!author=ctf-ai-reverse
#!system=ios

[Script]
g1-30swap = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,script-path=https://cdn.jsdelivr.net/gh/takagisangmie/g1-30swap@main/g1-30swap.js,max-size=1048576

[MITM]
hostname = one.google.com
